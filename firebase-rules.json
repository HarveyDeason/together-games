{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "$code.length === 4",
        ".write": "$code.length === 4",
        "meta": {
          "createdAt": {
            ".validate": "newData.isNumber()"
          },
          "currentGame": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "lastActivityAt": {
            ".validate": "newData.isNumber()"
          },
          "endedAt": {
            ".validate": "newData.isNumber()"
          },
          "$other": {
            ".validate": false
          }
        },
        "players": {
          "$clientId": {
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
            },
            "seat": {
              ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1)"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "presence": {
          "$clientId": {
            ".validate": "newData.isBoolean()"
          }
        },
        "game": {
          "id": {
            ".validate": "newData.isString() && newData.val().length <= 32"
          },
          "scored": {
            ".validate": "newData.isBoolean()"
          },
          "state": {
            ".validate": "newData.hasChildren(['turn', 'moves'])",
            "turn": {
              ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1)"
            },
            "moves": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50000"
            },
            "board": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "pos0": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "pos1": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "die": {
              ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 6"
            },
            "from": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "via": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "to": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
            },
            "seat": {
              ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1)"
            },
            "first": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
            },
            "phase": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            },
            "actor": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1"
            },
            "cash": {
              "$index": {
                ".validate": "newData.isNumber() && newData.val() >= -100000 && newData.val() <= 1000000"
              }
            },
            "pos": {
              "$index": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 39"
              }
            },
            "jail": {
              "$index": {
                ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
              }
            },
            "outCards": {
              "$index": {
                ".validate": "newData.isString() && newData.val().length <= 4"
              }
            },
            "own": {
              ".validate": "newData.isString() && newData.val().length === 40"
            },
            "built": {
              ".validate": "newData.isString() && newData.val().length === 40"
            },
            "mortg": {
              ".validate": "newData.isString() && newData.val().length === 40"
            },
            "deckLJ": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "curLJ": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            },
            "deckJB": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "curJB": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000"
            },
            "pot": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
            },
            "die1": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6"
            },
            "die2": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 6"
            },
            "doubles": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10"
            },
            "owed": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
            },
            "owedTo": {
              ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 1"
            },
            "pendingBuy": {
              ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 39"
            },
            "pendingCard": {
              ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 15"
            },
            "pendingDeck": {
              ".validate": "newData.isString() && newData.val().length <= 2"
            },
            "settleOffer": {
              ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 1"
            },
            "over": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            },
            "winner": {
              ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 1"
            },
            "aucSq": {
              ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 39"
            },
            "aucBid": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000000"
            },
            "aucBy": {
              ".validate": "newData.isNumber() && newData.val() >= -1 && newData.val() <= 1"
            },
            "aucPass": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2"
            },
            "tradeSeq": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
            },
            "trades": {
              "$tradeId": {
                ".validate": "$tradeId.matches(/^t[0-9]{1,6}$/) && newData.hasChildren(['props', 'cash', 'awaits'])",
                "props": {
                  ".validate": "newData.isString() && newData.val().length === 40"
                },
                "cash": {
                  ".validate": "newData.isNumber() && newData.val() >= -1000000 && newData.val() <= 1000000"
                },
                "outs0": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2"
                },
                "outs1": {
                  ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 2"
                },
                "awaits": {
                  ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1)"
                },
                "$other": {
                  ".validate": false
                }
              }
            },
            "log": {
              "$index": {
                ".validate": "newData.isString() && newData.val().length <= 160"
              }
            },
            "throws": {
              ".validate": "newData.isString() && newData.val().length === 2"
            },
            "last": {
              ".validate": "newData.isString() && newData.val().length === 2"
            },
            "wins": {
              ".validate": "newData.isString() && newData.val().length === 2"
            },
            "$other": {
              ".validate": false
            }
          },
          "$other": {
            ".validate": false
          }
        },
        "chat": {
          "$messageId": {
            "from": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "text": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 500"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "reactions": {
          "$reactionId": {
            "from": {
              ".validate": "newData.isString() && newData.val().length <= 64"
            },
            "emoji": {
              ".validate": "newData.isString() && newData.val().length <= 8"
            },
            "at": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "scores": {
          "$gameId": {
            "$key": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
